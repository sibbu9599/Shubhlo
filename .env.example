# ==========================================
# SHUBHLO PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Flask App Secret Key (Generate a random secure key)
SECRET_KEY=shubhlo_prod_secret_key_change_me_987654

# Server Port (Render/Railway/Heroku auto-injects $PORT)
PORT=8080

# Production MySQL Database Connection
# If using Railway/Render/Aiven/AWS RDS/Hostinger MySQL:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=shubhlo_db

# Fast2SMS OTP Gateway (Optional for live OTP SMS)
# Get your API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Gmail SMTP for Email Notifications / OTP (Optional)
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-digit-google-app-password

